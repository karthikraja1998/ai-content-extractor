generator client {
  provider = "prisma-client-js"
  output   = "client"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Content {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  summary   String?
  keyPoints String?
  createdAt DateTime @default(now())
}
